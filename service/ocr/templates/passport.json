    },
    {
      "key": "given_names",
      "label": "Nombres",
      "type": "text",
      "category": "personal"
    },
    {
      "key": "birth_date",
      "label": "Fecha de nacimiento",
      "type": "date",
      "category": "personal"
    },
    {
      "key": "sex",
      "label": "Sexo",
      "type": "single_letter",
      "category": "personal"
    },
    {
      "key": "nationality",
      "label": "Nacionalidad",
      "type": "text",
      "category": "personal"
    },
    {
      "key": "lugar_de_nacimiento",
      "label": "Lugar de nacimiento",
      "type": "text",
      "category": "personal"
    },
    {
      "key": "n_mero_personal",
      "label": "Número personal",
      "type": "alphanumeric",
      "category": "personal"
