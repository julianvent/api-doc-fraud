{
  "schema_version": 2,
  "document_type": "visa",
  "document_name": "visa",
  "country": "IND",
  "country_iso": "IND",
  "doc_family": "proof_of_address",
  "mrz_type": null,
  "img_path": "template/test/visa.png",
  "fingerprint": {
    "layout_desc": "Visa-type document, MRZ TD3 bottom right, blue color, photo top-right.",
    "anchors": [
      "REPUBLIC OF INDIA",
      "VISA",
      "S-6"
    ]
  },
  "fields": [
    {
      "key": "surname",
      "label": "Surname",
      "type": "text",
      "category": "personal"
    },
    {
      "key": "given_names",
      "label": "Given Names",
      "type": "text",
      "category": "personal"
    },
    {
      "key": "document_number",
      "label": "Passport No.",
      "type": "alphanumeric",
      "category": "document"
    },
    {
      "key": "expiry_date",
      "label": "Expiry date",
      "type": "date",
      "category": "document"
    },
    {
      "key": "date_of_issue",
      "label": "Date of Issue",
      "type": "date",
      "category": "document"
    },
    {
      "key": "visa_type",
      "label": "Visa Type",
      "type": "text",
      "category": "document"
    },
    {
      "key": "no_of_entries",
      "label": "No Of Entries",
      "type": "text",
      "category": "document"
    },
    {
      "key": "special_endorsement",
      "label": "Special Endorsement",
      "type": "text",
      "category": "document"
    }
  ],
  "field_rules": {
    "document_number": {
      "regex": "^N[0-9]{8}$"
    },
    "expiry_date": {
      "type": "date",
      "must_be_future": true
    }
  },
  "qr_config": {
    "present": false,
    "signed": false
  }
}